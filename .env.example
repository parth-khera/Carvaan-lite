NODE_ENV=production
PORT=5000
JWT_SECRET=change-this-to-a-secure-random-string

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/carvaan-connect

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
